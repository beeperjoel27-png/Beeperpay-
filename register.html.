<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Beeperpay - Create Account</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{
font-family:Arial,sans-serif;
background:#07152e;
color:white;
min-height:100vh;
display:flex;
align-items:center;
justify-content:center;
padding:20px;
}
.container{
width:100%;
max-width:450px;
background:#122747;
padding:32px;
border-radius:15px;
border:1px solid #d6a943;
}
.logo{
text-align:center;
font-size:28px;
font-weight:bold;
color:#e4b84e;
margin-bottom:5px;
}
.subtitle{
text-align:center;
color:#dce3ef;
font-size:13px;
margin-bottom:25px;
}
h2{
text-align:center;
color:#e4b84e;
margin-bottom:22px;
}
label{
display:block;
margin:13px 0 6px;
font-size:14px;
}
input{
width:100%;
padding:13px;
border:1px solid #526581;
border-radius:7px;
background:#07152e;
color:white;
font-size:15px;
}
button{
width:100%;
padding:14px;
margin-top:23px;
background:#e4b84e;
color:#07152e;
border:0;
border-radius:7px;
font-weight:bold;
font-size:16px;
cursor:pointer;
}
.note{
text-align:center;
margin-top:18px;
font-size:13px;
color:#dce3ef;
}
a{color:#e4b84e;text-decoration:none}
.message{
margin-top:15px;
text-align:center;
color:#e4b84e;
font-size:13px;
}
</style>
</head>
<body>
<div class="container">
<div class="logo">BEEPERPAY</div>
<div class="subtitle">MICROFINANCE BANK</div>
<h2>Create Your Account</h2>
<form id="registerForm">
<label>Full Name</label>
<input type="text" name="name" placeholder="Enter your full name" autocomplete="name" required>
<label>Email Address</label>
<input type="email" name="email" placeholder="Enter your email" autocomplete="email" required>
<label>Phone Number</label>
<input type="tel" name="phone" placeholder="Enter your phone number" autocomplete="tel" required>
<label>Password</label>
<input type="password" name="password" placeholder="Create a password" autocomplete="new-password" minlength="8" required>
<label>Confirm Password</label>
<input type="password" name="confirmPassword" placeholder="Confirm your password" autocomplete="new-password" minlength="8" required>
<button type="submit">CREATE ACCOUNT</button>
<div class="message" id="message"></div>
</form>
<div class="note">
Already have an account?
<a href="login.html">Login here</a>
</div>
<div class="note">
<a href="index.html">← Back to Home</a>
</div>
</div>
<script>
document.getElementById("registerForm").addEventListener("submit",function(event){
event.preventDefault();
const password=this.password.value;
const confirmPassword=this.confirmPassword.value;
const message=document.getElementById("message");
if(password.length<8){
message.textContent="Password must contain at least 8 characters.";
return;
}
if(password!==confirmPassword){
message.textContent="Passwords do not match.";
return;
}
message.textContent="Registration form is ready. Secure account registration will be activated when Beeperpay's backend is connected.";
});
</script>
</body>
</html>
